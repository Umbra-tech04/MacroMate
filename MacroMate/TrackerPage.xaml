<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MacroMate.TrackerPage"
             Title="Daily Tracker">

    <VerticalStackLayout Padding="16" Spacing="0">

        <!--Date navigation-->
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="24" Margin="0,8,0,16">
            <Button x:Name="MoveLeft" Text="←" Clicked="MoveLeft_Clicked" BackgroundColor="Transparent" TextColor="White" FontSize="20"/>
            <Label x:Name="DataLabel" Text="August 18, 2026" VerticalOptions="Center" FontSize="18" FontAttributes="Bold"/>
            <Button x:Name="MoveRight" Text="→" Clicked="MoveRight_Clicked" BackgroundColor="Transparent" TextColor="White" FontSize="20"/>
        </HorizontalStackLayout>

        <!--Tab buttons-->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,0,0,16">
            <Button Grid.Column="0" x:Name="MealsBtn" Text="🍽 Meals" Clicked="MealsBtn_Clicked"/>
            <Button Grid.Column="1" x:Name="WorkoutBtn" Text="🏋️ Workout" Clicked="WorkoutBtn_Clicked" BackgroundColor="Transparent" BorderColor="Gray" BorderWidth="1" TextColor="Gray"/>
        </Grid>

        <!--Meals content-->
        <VerticalStackLayout x:Name="MealsContent">
            <ScrollView>
                <VerticalStackLayout x:Name="MealsList" Spacing="8">
                </VerticalStackLayout>
            </ScrollView>
            <Button x:Name="AddMealBtn" Text="+ Add Meal" Clicked="AddMealBtn_Clicked" Margin="0,12,0,0"/>
        </VerticalStackLayout>

        <!--Workout content-->
        <VerticalStackLayout x:Name="WorkoutContent" IsVisible="False">
            <Label Text="Workout content here" />
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>