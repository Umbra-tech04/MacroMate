<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MacroMate.AddMealPage"
             Title="Add Meal">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Picker x:Name="MealTypePicker" Title="Meal type">
                <Picker.Items>
                    <x:String>Breakfast</x:String>
                    <x:String>Lunch</x:String>
                    <x:String>Dinner</x:String>
                    <x:String>Snack</x:String>
                </Picker.Items>
            </Picker>

            <Entry x:Name="DescriptionEntry" Placeholder="What did you eat?" Keyboard="Plain"/>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8" Margin="0,8,0,0">
                <Entry Grid.Row="0" Grid.Column="0" x:Name="CaloriesEntry" Placeholder="Calories (kcal)" Keyboard="Numeric"/>
                <Entry Grid.Row="0" Grid.Column="1" x:Name="ProteinEntry" Placeholder="Protein (g)" Keyboard="Numeric"/>
                <Entry Grid.Row="1" Grid.Column="0" x:Name="FatEntry" Placeholder="Fat (g)" Keyboard="Numeric"/>
                <Entry Grid.Row="1" Grid.Column="1" x:Name="CarbsEntry" Placeholder="Carbs (g)" Keyboard="Numeric"/>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,12,0,0">
                <Button Grid.Column="0" x:Name="Cancelbtn" Text="Cancel" Clicked="Cancelbtn_Clicked" BackgroundColor="Transparent" TextColor="Gray" BorderColor="Gray" BorderWidth="1"/>
                <Button Grid.Column="1" x:Name="Savebtn" Text="Add Meal" Clicked="Savebtn_Clicked"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>